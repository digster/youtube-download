# Relative paths resolve from the directory where the server is started.
YTDL_DATA_DIR=./data
# Startup folder for new playlists. A folder saved in Account & setup takes precedence.
YTDL_DOWNLOAD_DIR=./data/downloads
YTDL_PORT=8765
YTDL_LOG_LEVEL=INFO
# Optional Google Desktop app OAuth client file. Otherwise auto-detects
# ./client_secrets.json or ../youtube-backup/client_secrets.json.
# A client JSON chosen through Account & setup takes precedence.
YTDL_CLIENT_SECRETS=
# Optional startup defaults: Netscape cookie file OR browser name/profile
# (e.g. firefox, safari, chrome, or firefox:default).
# OAuth lists account playlists; yt-dlp needs cookies for private/restricted videos.
# Prefer Account & setup to choose a source without restarting. Saved UI choices
# override these values; "Use startup defaults" restores them.
YTDL_COOKIES_FILE=
YTDL_COOKIES_BROWSER=
# Defaults to the best available video and audio; ffmpeg merges the streams.
# Saved Download settings in the UI override this startup value; use
# "Restore startup defaults" there to return to it.
YTDL_FORMAT=bv*+ba/b
# Uses the API implemented by TheTechRobo/youtubevideofinder. May point to a self-hosted instance.
YTDL_FINDER_URL=https://findyoutubevideo.thetechrobo.ca
